#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1

start_service() {
	/usr/libexec/wifi-proxy/routes direct starting || return 1
	procd_open_instance watchdog
	procd_set_param command /usr/libexec/wifi-proxy/health run
	# A killed watchdog returns to direct mode on restart, then checks the tunnel anew.
	procd_set_param respawn 3600 2 0
	procd_set_param limits nofile='64 64' core='0'
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/libexec/wifi-proxy/routes direct stopped
}
