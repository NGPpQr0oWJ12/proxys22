#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get wifi_proxy.main.protocol)" != amneziawg ] || return 0
	# Forward normally until the separate end-to-end health check succeeds.
	rm -f /var/run/wifi-proxy/client.generation /var/run/wifi-proxy/health.successes
	/usr/libexec/wifi-proxy/routes direct starting || return 1
	[ "$(uci -q get wifi_proxy.main.enabled)" = '1' ] || return 0
	[ -s /etc/wifi-proxy/client.json ] || return 0
	procd_open_instance client
	procd_set_param command /usr/bin/hysteria client --config /etc/wifi-proxy/client.json --log-level warn
	# Retry indefinitely: an unplugged uplink at boot must not require manual recovery.
	procd_set_param respawn 3600 5 0
	procd_set_param limits nofile='4096 4096' core='0'
	procd_set_param env GOMEMLIMIT=48MiB GOGC=100
	procd_set_param file /etc/wifi-proxy/client.json
	procd_set_param stdout 0
	# Credentials are never emitted by our scripts; native diagnostics stay local.
	procd_set_param stderr 1
	procd_close_instance
	# A changed generation invalidates an in-flight probe from the previous client.
	printf '%s\n' "$$" > /var/run/wifi-proxy/client.generation
}

stop_service() {
	[ "$(uci -q get wifi_proxy.main.protocol)" != amneziawg ] || return 0
	rm -f /var/run/wifi-proxy/client.generation /var/run/wifi-proxy/health.successes
	/usr/libexec/wifi-proxy/routes stop
}

service_triggers() {
	procd_add_reload_trigger wifi_proxy
}
